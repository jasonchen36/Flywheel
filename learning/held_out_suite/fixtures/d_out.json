    {
      "id": "out_airflow_upstream_diag_preserved",
      "domain": "general",
      "pattern": "airflow_blind_retry",
      "response": "Checked task logs. Upstream get_interval still running \u2014 trigger_rule means this task waited on unfinished upstream. Will not clear/retry until all upstream succeed.",
      "expect": {
