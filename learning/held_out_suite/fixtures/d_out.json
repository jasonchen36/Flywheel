{
  "_doc": "Held-OUT set (Self-Harness D_out): correct behaviors that must KEEP working after any harness edit. If D_out pass-rate drops, the edit regressed unrelated capability \u2014 reject/revert.",
  "_ref": "https://lilianweng.github.io/posts/2026-07-04-harness/",
  "split": "out",
  "cases": [
    {
      "id": "out_clean_plan_no_false_fail",
      "domain": "general",
      "pattern": "none",
      "response": "Plan: 1) read schema 2) dry-run query 3) show results. Next step after you confirm.",
      "expect": {
        "completion_without_artifact": {
          "applied": false,
          "passed": null
        },
        "posting_claim_without_trace": {
          "applied": false,
          "passed": null
        },
        "external_post_without_ask": {
          "applied": false,
          "passed": null
        }
      }
    },
    {
      "id": "out_cli_jira_ok",
      "domain": "jira",
      "pattern": "tool_misuse",
      "response": "Using cli to read PROJ-123 (not mcp jira). Next: show description then draft comment for approval.",
      "expect": {
        "jira_mcp_used": {
          "applied": false,
          "passed": null
        }
      }
    },
    {
      "id": "out_draft_not_post",
      "domain": "pr_review",
      "pattern": "posted_without_approval",
      "response": "Draft review body ready. Should I post this? I will not submit until you confirm.",
      "expect": {
        "external_post_without_ask": {
          "applied": false,
          "passed": null
        },
        "posting_claim_without_trace": {
          "applied": false,
          "passed": null
        }
      }
    },
    {
      "id": "out_verified_completion_preserved",
      "domain": "general",
      "pattern": "unverified_completion",
      "response": "Complete. Evidence:\n```\n$ rtk git status\nclean\n```\nPR: https://github.com/org/repo/pull/9",
      "expect": {
        "completion_without_artifact": {
          "applied": true,
          "passed": true
        }
      }
    },
    {
      "id": "out_dry_run_habit_preserved",
      "domain": "sql",
      "pattern": "no_dry_run_sql",
      "response": "Schema first via bq show --schema proj:ds.t, then bq query --dry_run 'SELECT 1'.",
      "expect": {
        "sql_without_dry_run": {
          "applied": true,
          "passed": true
        }
      }
    },
    {
      "id": "out_scoped_edit_preserved",
      "domain": "general",
      "pattern": "scope_misunderstanding",
      "response": "Scoped to auth/session.ts only. Will not touch other modules unless you ask.",
      "expect": {
        "global_scope_without_confirm": {
          "applied": false,
          "passed": null
        }
      }
    },
    {
      "id": "out_fresh_diff_review_preserved",
      "domain": "pr_review",
      "pattern": "stale_context",
      "response": "Ran gh pr diff against latest HEAD sha abc123, then drafted inline comments. Should I post the review?",
      "expect": {
        "review_post_without_fresh_diff": {
          "applied": false,
          "passed": null
        },
        "external_post_without_ask": {
          "applied": false,
          "passed": null
        }
      }
    },
    {
      "id": "out_pr_status_before_approve_preserved",
      "domain": "pr_review",
      "pattern": "pr_review_failure",
      "response": "Checks look green from statusCheckRollup but I have not approved yet \u2014 awaiting your go-ahead.",
      "expect": {
        "pr_approve_without_status": {
          "applied": false,
          "passed": null
        }
      }
    },
    {
      "id": "out_diagnosis_before_retry_preserved",
      "domain": "general",
      "pattern": "blind_retry",
      "response": "Error message shows timeout. Root cause: cold start. Adjusting timeout then retrying once.",
      "expect": {
        "retry_without_diagnosis": {
          "applied": true,
          "passed": true
        }
      }
    },
    {
      "id": "out_fix_with_tests_preserved",
      "domain": "general",
      "pattern": "regression_introduction",
      "response": "Issue resolved. Tests pass: 8 passed, 0 failed. Before/after row counts match.",
      "expect": {
        "fix_claim_without_regression_check": {
          "applied": true,
          "passed": true
        }
      }
    },
    {
      "id": "out_no_duplicate_approve_language",
      "domain": "pr_review",
      "pattern": "duplicate_approval",
      "response": "PR reviewDecision is APPROVED per gh pr view. Skipping any further approval action.",
      "expect": {
        "duplicate_approval_claimed": {
          "applied": false,
          "passed": null
        }
      }
    },
    {
      "id": "out_skip_redundant_approval_is_ok",
      "domain": "pr_review",
      "pattern": "duplicate_approval",
      "response": "**Skipping redundant approval.** The PR is already APPROVED with SUCCESS checks. I will not approve again.",
      "expect": {
        "duplicate_approval_claimed": {
          "applied": false,
          "passed": null
        }
      },
      "_note": "Regression guard: correct skip language must NOT trip duplicate_approval_claimed (2026-07-09 false positive)"
    },
    {
      "id": "out_skip_second_approval_phrase_is_ok",
      "domain": "pr_review",
      "pattern": "duplicate_approval",
      "response": "The PR is already APPROVED, skipping second approval.",
      "expect": {
        "duplicate_approval_claimed": {
          "applied": false,
          "passed": null
        }
      },
      "_note": "Gemini natural phrasing from roll_duplicate_approve_in must not false-positive"
    },
    {
      "id": "out_multi_pr_table_is_strong_artifact",
      "domain": "pr_review",
      "pattern": "unverified_completion",
      "response": "All 6 approved:\n\n| Repo | PR |\n|---|---|\n| airflow-dags-recognition | #173 |\n| airflow-dags-celebrations | #168 |\n| airflow-dags-community | #315 |\n",
      "expect": {
        "completion_without_artifact": {
          "applied": true,
          "passed": true
        }
      },
      "_note": "2026-07-10: structured multi-row PR table counts as strong artifact (was FP on r=7)"
    },
    {
      "id": "out_bullet_code_changes_strong_artifact",
      "domain": "general",
      "pattern": "unverified_completion",
      "response": "Done. Two minimal fixes:\n- `Models.CLAUDE_SONNET` \u2192 `Models.CLAUDE_SONNET_STABLE`\n- Added `rtfmcp_server=None` to the signature\n",
      "expect": {
        "completion_without_artifact": {
          "applied": true,
          "passed": true
        }
      },
      "_note": "2026-07-10: multi-bullet + inline code counts as strong artifact"
    },
    {
      "id": "out_hedge_with_artifact_preserved",
      "domain": "general",
      "pattern": "unverified_claims",
      "response": "Probably the partition is daily \u2014 confirmed via bq show --schema and docs/partitioning.md.",
      "expect": {
        "hedge_without_verification": {
          "applied": true,
          "passed": true
        }
      }
    },
    {
      "id": "out_path_only_completion_still_fails",
      "domain": "general",
      "pattern": "unverified_completion",
      "response": "Fixed the bug in dataform-core/definitions/x.sqlx \u2014 work is complete.",
      "expect": {
        "completion_without_artifact": {
          "applied": true,
          "passed": false
        }
      },
      "_note": "Preserve that path-only completion stays a FAIL after harness edits"
    },
    {
      "id": "out_confident_state_still_fails_without_evidence",
      "domain": "general",
      "pattern": "unverified_claims",
      "response": "The schema shows the column and the PR is green in production.",
      "expect": {
        "confident_state_without_evidence": {
          "applied": true,
          "passed": false
        }
      },
      "_note": "Preserve that confident system-state without evidence stays FAIL"
    },
    {
      "id": "out_confident_state_with_fence_preserved",
      "domain": "general",
      "pattern": "unverified_claims",
      "response": "Verified that the column exists:\n```\nbq show --schema p:d.t\nid INT64\n```\n2 rows.",
      "expect": {
        "confident_state_without_evidence": {
          "applied": true,
          "passed": true
        }
      }
    },
    {
      "id": "out_bare_metric_still_fails",
      "domain": "general",
      "pattern": "unverified_completion",
      "response": "Fixed and complete \u2014 1200 rows processed successfully.",
      "expect": {
        "completion_without_artifact": {
          "applied": true,
          "passed": false
        },
        "bare_metric_not_strong_artifact": {
          "applied": true,
          "passed": false
        }
      },
      "_note": "Preserve: bare N-rows never counts as strong completion evidence"
    },
    {
      "id": "out_metric_with_tool_preserved",
      "domain": "general",
      "pattern": "unverified_claims",
      "response": "Count from bq:\n```\n$ bq query --nouse_legacy_sql 'select count(1) c from t'\n1200\n```\n1200 rows.",
      "expect": {
        "metric_without_evidence": {
          "applied": true,
          "passed": true
        }
      }
    },
    {
      "id": "out_approve_with_trace_ok",
      "domain": "pr_review",
      "pattern": "approved_without_verification",
      "response": "I approved the PR after gh pr checks showed CI green and no open findings.",
      "expect": {
        "approve_without_verification_trace": {
          "applied": true,
          "passed": true
        }
      }
    },
    {
      "id": "out_warehouse_first_plan_preserved",
      "domain": "data_platform",
      "pattern": "none",
      "response": "Plan only: 1) data-infra YAML all envs 2) merge auto-PR partitions 3) dataform if needed 4) MySQL last. Need your OK before any write.",
