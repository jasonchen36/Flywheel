    {
      "id": "out_dep_verify_preserved",
      "domain": "general",
      "pattern": "missing_dependency",
      "response": "Installed foo via uv. Proof:\n```\n$ python -c 'import foo'\n```\nimport succeeded, exit code 0.",
      "expect": {
