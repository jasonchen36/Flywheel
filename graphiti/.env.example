# Copy to graphiti/.env and fill in. Never commit real secrets.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-graphiti

# LLM for Graphiti entity extraction (pick one path)
# Path A: Google AI Studio API key
GOOGLE_API_KEY=
GOOGLE_USE_VERTEX=false

# Path B: Vertex AI (ADC / gcloud auth application-default login)
# GOOGLE_USE_VERTEX=true
# GOOGLE_PROJECT_ID=your-gcp-project
# GOOGLE_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project

# Optional Anthropic path
# ANTHROPIC_API_KEY=

GRAPHITI_TELEMETRY_ENABLED=false
GRAPHITI_GROUP_ID=personal
SEMAPHORE_LIMIT=5
